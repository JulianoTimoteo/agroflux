# ─────────────────────────────────────────────────────────────
# AgroFlux — configuração de ambiente (EXEMPLO)
#
# Copie para `.env` e preencha com os dados do SEU projeto Firebase.
# Estes valores são a configuração PÚBLICA do cliente Firebase
# (é assim que o Google distribui) — a segurança real é feita pelas
# Firestore Security Rules em `firestore.rules`.
#
# NUNCA coloque aqui: service account, Firebase Admin SDK,
# private key, token administrativo ou senha de keystore.
# ─────────────────────────────────────────────────────────────

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ── Assinatura do APK de release (apenas na máquina local / CI) ──
# O arquivo .keystore NUNCA vai para o repositório.
# ANDROID_KEYSTORE_PATH=
# ANDROID_KEYSTORE_PASSWORD=
# ANDROID_KEY_ALIAS=
# ANDROID_KEY_PASSWORD=
